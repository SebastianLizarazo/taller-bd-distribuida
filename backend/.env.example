# URI del mongos. Por default apunta al puerto mapeado en el host por docker-compose.
# Si el backend corre dentro de la red docker, usar mongodb://mongos:27017.
MONGOS_URI=mongodb://localhost:27017

# Puerto del backend Express.
PORT=3001

# Nivel de log: 'info' | 'debug'. 'debug' loggea shard-targeting por query.
LOG_LEVEL=info